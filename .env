# IMPORTANT: This is your development .env file. Keep it private and do NOT commit to git.
# For production, ensure all secrets are properly managed through your deployment platform.

# Django
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Leave empty to use SQLite for development)
DATABASE_URL=

# JWT / Authentication
JWT_SECRET=your-jwt-secret-key-for-development
JWT_EXPIRES_IN=86400

# Node / Next.js
NODE_ENV=development
PORT=8000
