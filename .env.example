# IMPORTANT: copy this file to `.env` and add `.env` to .gitignore. Never commit your real secrets.
# Example environment variables for development and production
# Fill real values in your local `.env` file and keep secrets out of version control.

# Django
# Generate a secure secret key for production. Example (requires Django installed):
# python -c "from django.core.management.utils import get_random_secret_key; print(__import__('django').core.management.utils.get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-secure-random-string
# Set DEBUG=0 in production. Set to 1 only for local development when safe.
DEBUG=0  # Set to 1 only for local development. Ensure DEBUG is 0 in production and controlled via environment-specific configuration.
# Comma-separated list of allowed hosts. In production, set to your real domain(s).
ALLOWED_HOSTS=localhost,127.0.0.1  # In production set to your domain(s), e.g. example.com. Do not use '*' in production.

# Database (for Django settings or external usage)
# For PostgreSQL, set in the format below. Replace placeholders with real credentials.
# Example: postgresql://<username>:<password>@localhost:5432/<db_name>
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/<db_name>
# Leave DATABASE_URL empty to use SQLite (db.sqlite3) for local development if your settings support that.

# JWT / Authentication (used by custom JWT authentication utilities)
# Use a long, random secret separate from DJANGO_SECRET_KEY. Rotate periodically.
JWT_SECRET=replace-with-a-secure-jwt-secret
# Token expiry in seconds (e.g. 3600 = 1 hour)
JWT_EXPIRES_IN=3600
# Bcrypt salt rounds for password hashing (default 12)
BCRYPT_SALT_ROUNDS=12

# Node / Next.js (if you add Next.js services)
NODE_ENV=development
PORT=8000

# Other
# Add any other environment variables required by your deployment here.
